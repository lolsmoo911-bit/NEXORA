# OpenCode ⇄ ChatGPT bridge configuration
# Copy this file to .env and edit it. Never commit .env.

# Where the bridge listens. Keep 127.0.0.1 unless you put a reverse proxy in front.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Path of the MCP endpoint. Change it to a random string for a bit of extra safety.
BRIDGE_PATH=/mcp

# Optional bearer token. If set, every MCP request must send:
#   Authorization: Bearer <token>
# ChatGPT's "No authentication" mode cannot send this header; in that mode leave it
# empty and rely on the tunnel URL + BRIDGE_PATH as the secret.
BRIDGE_TOKEN=

# Default project directory for filesystem tools (leave empty for the OpenCode default).
BRIDGE_DIRECTORY=

# Allow opencode_send_message (ChatGPT can instruct the agent to run commands and edit files).
# Leave 0 unless you really want ChatGPT to be able to act on your machine.
BRIDGE_ALLOW_WRITE=0

# --- OAuth (recommended) ---
# ChatGPT does the browser login once, then uses short-lived Bearer tokens
# (refresh tokens are persisted in .auth/tokens.json across bridge restarts).
# Leave BRIDGE_OAUTH_PASSWORD empty to fall back to unauthenticated URL security.
BRIDGE_OAUTH_PASSWORD=
BRIDGE_OAUTH_CLIENT_ID=opencode-chatgpt

# Optional: pin the public base URL used in OAuth metadata when behind a proxy that
# does not send x-forwarded-proto.
# BRIDGE_PUBLIC_URL=

# Maximum characters returned per tool output.
BRIDGE_MAX_TOOL_OUTPUT=4000

# Number of live events kept in memory.
BRIDGE_EVENT_BUFFER=400

# Optional: connect to a specific OpenCode server instead of the background service.
# OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_PASSWORD=...
