// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import {Aid} from "../src/Aid.sol";

/**
 * Cross-implementation check for AID.
 *
 * Every value asserted here is the output of the independent JavaScript reference
 * implementation (aid/src/aid.mjs), generated by aid/test/emit-vectors.mjs and committed to
 * aid/vectors.json. If the two implementations ever disagree, these tests fail.
 *
 * That is the point. A suite written by one codebase and asserted by itself proves only
 * that the code runs.
 *
 * There is deliberately no forge-std import. The assertion helpers below are a few lines,
 * and depending on a network-fetched package to compare two hashes would add supply-chain
 * surface to the one check that must be reproducible.
 */

contract AidVectorTest {
    uint256 constant CHAIN = 902024;
    address constant TOKEN = address(0x1111111111111111111111111111111111111111);

    // ---------------------------------------------------------------- assertions

    function fail(string memory reason) private pure {
        revert(reason);
    }

    function assertEq(bytes32 a, bytes32 b, string memory what) private pure {
        if (a != b) {
            revert(string(abi.encodePacked(what, ": ", Aid.toCanonicalString(a), " != ", Aid.toCanonicalString(b))));
        }
    }

    function assertEq(bytes32 a, string memory b, string memory what) private pure {
        assertEq(a, Aid.fromCanonicalString(b), what);
    }

    function assertTrue(bool condition, string memory what) private pure {
        if (!condition) revert(what);
    }

    function assertEq(uint256 a, uint256 b, string memory what) private pure {
        if (a != b) revert(string(abi.encodePacked(what, ": ", _u(a), " != ", _u(b))));
    }

    function _u(uint256 n) private pure returns (string memory) {
        if (n == 0) return "0";
        bytes memory tmp;
        while (n > 0) {
            tmp = bytes(abi.encodePacked(bytes1(uint8(48 + (n % 10))), tmp));
            n /= 10;
        }
        return string(tmp);
    }

    /// @dev Runs `body` and requires it to revert. Solidity has no try/catch for internal
    ///      calls, so the expectation is expressed by reverting when it does NOT revert.
    function expectRevert(string memory what) private pure {
        revert(string(abi.encodePacked("expected revert: ", what)));
    }

    // ---------------------------------------------------------------- vectors

    function test_domainSeparatorMatchesTheReference() public pure {
        assertEq(
            Aid.domainSeparator(CHAIN),
            "269e6cd679db004a2c778774b6c0a8598ce1024d2db17a3ef9456d0b41097c8f",
            "domainSeparator"
        );
    }

    function test_vector1_native() public pure {
        assertEq(
            Aid.nativeId(CHAIN),
            "49d41c535f2cd20369abc4716c440120dd37cdf6aa748555288f6487d8bd5cf6",
            "vector 1"
        );
    }

    function test_vector2_erc20ZeroAddress() public pure {
        assertEq(
            Aid.erc20Id(CHAIN, address(0)),
            "eb359c6da469ec06319967f59468eb5b3e5af93f906d49d2df1eed87ed174d22",
            "vector 2"
        );
    }

    function test_vector3_erc20NativePrecompile() public pure {
        assertEq(
            Aid.erc20Id(CHAIN, address(0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE)),
            "553b10aa622c8be55ca381542bdd85a190f0ee783de956de8726232a22e79d41",
            "vector 3"
        );
    }

    function test_vector4_erc721TokenZero() public pure {
        assertEq(
            Aid.erc721Id(CHAIN, TOKEN, 0),
            "33df093688c7dd73352c4d48583aab0e9218a2c983ce042cb3fd918e0511ebbd",
            "vector 4"
        );
    }

    function test_vector5_erc721TokenOne() public pure {
        assertEq(
            Aid.erc721Id(CHAIN, TOKEN, 1),
            "fed2a02170af4e5ddd86e590988dc7bf5d505fb1e0dd8239a2994c50fd73b333",
            "vector 5"
        );
    }

    function test_vector6_erc1155Token77() public pure {
        assertEq(
            Aid.erc1155Id(CHAIN, TOKEN, 77),
            "bc54ca80c83ee4b08fd7a7a0bce6961c0e6196e4426a82bed61d2491e0b17fc1",
            "vector 6"
        );
    }

    function test_vector7_nativeOnChainOne() public pure {
        assertEq(
            Aid.nativeId(1),
            "16b92cc2928e2060bfcacff0ab37425270b3843c859fdee6d1e85677d9edf22f",
            "vector 7"
        );
    }

    // ---------------------------------------------------------------- properties

    function test_chainIdIsPartOfTheIdentity() public pure {
        assertTrue(Aid.nativeId(1) != Aid.nativeId(CHAIN), "chain id must separate domains");
        assertTrue(Aid.nativeId(5) != Aid.nativeId(1), "chain id must separate domains");
    }

    function test_assetTypeIsPartOfTheIdentity() public pure {
        assertTrue(Aid.erc721Id(CHAIN, TOKEN, 77) != Aid.erc1155Id(CHAIN, TOKEN, 77), "type must separate");
        assertTrue(Aid.erc20Id(CHAIN, TOKEN) != Aid.nativeId(CHAIN), "type must separate");
    }

    function test_tokenIdIsPartOfTheIdentity() public pure {
        assertTrue(Aid.erc721Id(CHAIN, TOKEN, 0) != Aid.erc721Id(CHAIN, TOKEN, 1), "token id must separate");
        assertTrue(
            Aid.erc721Id(CHAIN, TOKEN, type(uint256).max) != Aid.erc721Id(CHAIN, TOKEN, 0),
            "token id must not be truncated"
        );
    }

    function test_canonicalTextRoundTrips() public pure {
        bytes32 id = Aid.erc721Id(CHAIN, TOKEN, 1);
        assertEq(Aid.fromCanonicalString(Aid.toCanonicalString(id)), id, "round trip");
        assertEq(bytes(Aid.toCanonicalString(id)).length, 64, "canonical length");
    }

    // ---------------------------------------------------------------- rejections
    // These expect a revert. A test that cannot express "must revert" is a test that cannot
    // prove rejection, so each one is written as: if the call returns, fail loudly.

    function test_unknownAssetTypeIsRejected() public pure {
        bool reverted;
        try this.tryAssetId(4) returns (bytes32) {
            reverted = false;
        } catch {
            reverted = true;
        }
        assertTrue(reverted, "asset type 4 must be rejected, not hashed");
    }

    function test_unknownSpecVersionIsRejected() public pure {
        bool reverted;
        try this.trySpecVersion(2) returns (bytes32) {
            reverted = false;
        } catch {
            reverted = true;
        }
        assertTrue(reverted, "unknown spec version must be rejected");
    }

    function test_uppercaseCanonicalTextIsRejected() public pure {
        bytes memory upper = bytes(Aid.toCanonicalString(Aid.nativeId(CHAIN)));
        for (uint256 i = 0; i < upper.length; i++) {
            if (upper[i] >= "a" && upper[i] <= "f") {
                upper[i] = bytes1(uint8(upper[i]) - 32);
            }
        }
        bool reverted;
        try this.tryParse(string(upper)) returns (bytes32) {
            reverted = false;
        } catch {
            reverted = true;
        }
        assertTrue(reverted, "uppercase must be rejected at the boundary, not normalised");
    }

    function test_wrongLengthCanonicalTextIsRejected() public pure {
        bool reverted;
        try this.tryParse("abc") returns (bytes32) {
            reverted = false;
        } catch {
            reverted = true;
        }
        assertTrue(reverted, "a short string must be rejected");
    }

    // ---------------------------------------------------------------- external wrappers

    function tryAssetId(uint8 t) external pure returns (bytes32) {
        return Aid.assetId(CHAIN, t, bytes32(0));
    }

    function trySpecVersion(uint256 v) external pure returns (bytes32) {
        return Aid.domainSeparator(CHAIN, v);
    }

    function tryParse(string calldata text) external pure returns (bytes32) {
        return Aid.fromCanonicalString(text);
    }
}