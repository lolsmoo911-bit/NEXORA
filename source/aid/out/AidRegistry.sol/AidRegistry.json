n\":\"0.8.24+commit.e11b9ed9\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"assetId\",\"type\":\"bytes32\"}],\"name\":\"AidAlreadyRegistered\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"claimed\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"computed\",\"type\":\"bytes32\"}],\"name\":\"AidMetadataDoesNotMatchIdentifier\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"assetId\",\"type\":\"bytes32\"}],\"name\":\"AidNotRegistered\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"assetId\",\"type\":\"bytes32\"},{\"internalType\":\"address\",\"name\":\"caller\",\"type\":\"address\"}],\"name\":\"AidNotTheRegistrant\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"AidUnknownSpecVersion\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"uint8\",\"name\":\"assetType\",\"type\":\"uint8\"}],\"name\":\"AidUnknownType\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"AidZeroRegistrant\",\"type\":\"error\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"assetId\",\"type\":\"bytes32\"},{\"indexed\":true,\"internalType\":\"uint8\",\"name\":\"assetType\",\"type\":\"uint8\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"registrant\",\"type\":\"address\"}],\"name\":\"Registered\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"assetId\",\"type\":\"bytes32\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"registrant\",\"type\":\"address\"}],\"name\":\"Retracted\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"index\",\"type\":\"uint256\"}],\"name\":\"assetIdAt\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"assetId\",\"type\":\"bytes32\"}],\"name\":\"get\",\"outputs\":[{\"components\":[{\"internalType\":\"uint8\",\"name\":\"assetType\",\"type\":\"uint8\"},{\"internalType\":\"enum AidRegistry.Status\",\"name\":\"status\",\"type\":\"uint8\"},{\"internalType\":\"address\",\"name\":\"registrant\",\"type\":\"address\"},{\"internalType\":\"uint64\",\"name\":\"registeredAt\",\"type\":\"uint64\"},{\"internalType\":\"uint64\",\"name\":\"retractedAt\",\"type\":\"uint64\"}],\"internalType\":\"struct AidRegistry.Entry\",\"name\":\"\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"assetId\",\"type\":\"bytes32\"}],\"name\":\"isRegistered\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"from\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"max\",\"type\":\"uint256\"}],\"name\":\"paginate\",\"outputs\":[{\"components\":[{\"internalType\":\"uint8\",\"name\":\"assetType\",\"type\":\"uint8\"},{\"internalType\":\"enum AidRegistry.Status\",\"name\":\"status\",\"type\":\"uint8\"},{\"internalType\":\"address\",\"name\":\"registrant\",\"type\":\"address\"},{\"internalType\":\"uint64\",\"name\":\"registeredAt\",\"type\":\"uint64\"},{\"internalType\":\"uint64\",\"name\":\"retractedAt\",\"type\":\"uint64\"}],\"internalType\":\"struct AidRegistry.Entry[]\",\"name\":\"entries\",\"type\":\"tuple[]\"},{\"internalType\":\"bytes32[]\",\"name\":\"ids\",\"type\":\"bytes32[]\"},{\"internalType\":\"uint256\",\"name\":\"next\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"assetId\",\"type\":\"bytes32\"},{\"internalType\":\"uint8\",\"name\":\"assetType\",\"type\":\"uint8\"},{\"internalType\":\"bytes32\",\"name\":\"assetKey\",\"type\":\"bytes32\"},{\"internalType\":\"uint256\",\"name\":\"chainId\",\"type\":\"uint256\"}],\"name\":\"register\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"assetId\",\"type\":\"bytes32\"}],\"name\":\"registrantOf\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"assetId\",\"type\":\"bytes32\"}],\"name\":\"retract\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"assetId\",\"type\":\"bytes32\"}],\"name\":\"statusOf\",\"outputs\":[{\"internalType\":\"enum AidRegistry.Status\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"totalRegistrations\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"assetId\",\"type\":\"bytes32\"},{\"internalType\":\"uint256\",\"name\":\"chainId\",\"type\":\"uint256\"},{\"internalType\":\"bytes32\",\"name\":\"assetKey\",\"type\":\"bytes32\"}],\"name\":\"verify\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"register(bytes32,uint8,bytes32,uint256)\":{\"params\":{\"assetId\":\"the identifier, as produced by Aid.assetId\",\"assetKey\":\"the 32-byte key, which is re-hashed and checked Reverts if the id is already registered, or if the supplied type and key do not reproduce `assetId`. The second check is the whole reason this contract is not just a mapping: it makes a false entry unrepresentable rather than merely unlikely.\",\"assetType\":\"the asset type, which is re-derived and checked\"}}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"assetIdAt(uint256)\":{\"notice\":\"The nth identifier ever registered, including retracted ones.\"},\"paginate(uint256,uint256)\":{\"notice\":\"Every registered entry at `from`, up to `max` entries. Cursor pagination,         because an unbounded loop over all assets would be uncallable at any real size.\"},\"register(bytes32,uint8,bytes32,uint256)\":{\"notice\":\"Files a claim for `assetId`.\"},\"retract(bytes32)\":{\"notice\":\"Retracts a claim. Only the original registrant may do this, and a retraction         is final: the identifier cannot be claimed again. \\\"Final\\\" is a deliberate cost. If a retracted identifier could be re-registered, then a retraction would be an invitation to squat, and the first-claim-wins property above would hold only until the first bad actor arrived.\"},\"verify(bytes32,uint256,bytes32)\":{\"notice\":\"Verifies a stored entry against the identifier scheme, on demand. Every registration already enforced this, so a conforming registry always returns true. It exists so that a consumer holding an assetId and a key can prove the pair is genuine rather than trusting the caller's word, and so that a future state migration (Phase 6) has something to validate against.\"}},\"notice\":\"NEXORA Asset Identifier Registry \\u2014 minimal. WHAT THIS IS NOT ---------------- Registering here does NOT attest that an asset exists, that the registrar controls it, or that its code matches its declared type. `aid/SPEC.md` \\u00a73 is explicit that an `assetId` is an identifier and not a claim about the world; this contract stores a *claim* and says so. A consumer that treats registry membership as proof of existence is misreading it. WHAT IT DOES GUARANTEE ---------------------- 1. **The metadata hashes to the identifier it is filed under.** Every registration    recomputes `assetId(assetType, assetKey)` and reverts if it does not equal the id being    registered. A registry entry therefore cannot disagree with the identifier scheme. 2. **First claim wins, permanently.** A registered identifier cannot be overwritten by a    later registrant. If re-registration were allowed, the directory would be a mutable    pointer that anyone could repoint, and its contents would carry no weight. 3. **Only the original registrant can retract.** Deregistration is a statement by the    party that made the claim, not by a third party. There is no owner, no upgrade path, and no pause. A directory with those features is a governance problem, and Phase 8 governance does not exist yet.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/AidRegistry.sol\":\"AidRegistry\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"src/Aid.sol\":{\"keccak256\":\"0x74494a8486c6d89b4e6380b78250ae1a56a37b7fea6802d183ecb40f03cb0092\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://ab64b956e936499c03cef105062c05c00a1a6520cb837c7dfc590b5e24146444\",\"dweb:/ipfs/QmbQyoydVbaQVySLn9Sr7HazBxHCDEPtfUFpFgZJwmzi4D\"]},\"src/AidRegistry.sol\":{\"keccak256\":\"0x78555fcebbdc064eecc7f0f8a4fb41bbd89bc519d387b7d6c75939313aee22b7\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://816adb2f992399d65feef043ed06b2c34b2e1b607ee9cb7f7a10a6bdc4256617\",\"dweb:/ipfs/QmWZdBjX4M17NJyUbbg8tkeVZ5na3Psb9qwPamaBGFywxw\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.24+commit.e11b9ed9"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"bytes32","name":"assetId","type":"bytes32"}],"type":"error","name":"AidAlreadyRegistered"},{"inputs":[{"internalType":"bytes32","name":"claimed","type":"bytes32"},{"internalType":"bytes32","name":"computed","type":"bytes32"}],"type":"error","name":"AidMetadataDoesNotMatchIdentifier"},{"inputs":[{"internalType":"bytes32","name":"assetId","type":"bytes32"}],"type":"error","name":"AidNotRegistered"},{"inputs":[{"internalType":"bytes32","name":"assetId","type":"bytes32"},{"internalType":"address","name":"caller","type":"address"}],"type":"error","name":"AidNotTheRegistrant"},{"inputs":[],"type