{
  "name": "opencode-chatgpt-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP bridge that lets ChatGPT talk to, and observe, a local OpenCode agent.",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test:proxy": "node scripts/proxy-manager-test.mjs",
    "test:core": "node scripts/core-test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opencode/client": "^2.1.2",
    "zod": "^4.6.7"
  }
}
