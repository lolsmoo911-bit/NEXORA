{
    "$schema":  "https://opencode.ai/config.json",
    "permissions":  [
                        {
                            "action":  "read",
                            "resource":  "*",
                            "effect":  "allow"
                        },
                        {
                            "action":  "edit",
                            "resource":  "*",
                            "effect":  "allow"
                        },
                        {
                            "action":  "glob",
                            "resource":  "*",
                            "effect":  "allow"
                        },
                        {
                            "action":  "grep",
                            "resource":  "*",
                            "effect":  "allow"
                        },
                        {
                            "action":  "shell",
                            "resource":  "*",
                            "effect":  "ask"
                        },
                        {
                            "action":  "shell",
                            "resource":  "python -m unittest *",
                            "effect":  "allow"
                        },
                        {
                            "action":  "shell",
                            "resource":  "python -m compileall *",
                            "effect":  "allow"
                        },
                        {
                            "action":  "shell",
                            "resource":  "python -m py_compile *",
                            "effect":  "allow"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git status *",
                            "effect":  "allow"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git diff *",
                            "effect":  "allow"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git log *",
                            "effect":  "allow"
                        },
                        {
                            "action":  "read",
                            "resource":  "*.env",
                            "effect":  "deny"
                        },
                        {
                            "action":  "read",
                            "resource":  "*.env.*",
                            "effect":  "deny"
                        },
                        {
                            "action":  "read",
                            "resource":  "*.pem",
                            "effect":  "deny"
                        },
                        {
                            "action":  "read",
                            "resource":  "*.key",
                            "effect":  "deny"
                        },
                        {
                            "action":  "read",
                            "resource":  "*.db*",
                            "effect":  "deny"
                        },
                        {
                            "action":  "read",
                            "resource":  "*.sqlite*",
                            "effect":  "deny"
                        },
                        {
                            "action":  "edit",
                            "resource":  "*.env",
                            "effect":  "deny"
                        },
                        {
                            "action":  "edit",
                            "resource":  "*.env.*",
                            "effect":  "deny"
                        },
                        {
                            "action":  "edit",
                            "resource":  "*.pem",
                            "effect":  "deny"
                        },
                        {
                            "action":  "edit",
                            "resource":  "*.key",
                            "effect":  "deny"
                        },
                        {
                            "action":  "edit",
                            "resource":  "*.db*",
                            "effect":  "deny"
                        },
                        {
                            "action":  "edit",
                            "resource":  "*.sqlite*",
                            "effect":  "deny"
                        },
                        {
                            "action":  "edit",
                            "resource":  ".git/**",
                            "effect":  "deny"
                        },
                        {
                            "action":  "edit",
                            "resource":  "apps/market-data-hub/var/**",
                            "effect":  "deny"
                        },
                        {
                            "action":  "edit",
                            "resource":  "docs/DECISION-LOG.md",
                            "effect":  "deny"
                        },
                        {
                            "action":  "edit",
                            "resource":  "docs/WORK-QUEUE.md",
                            "effect":  "deny"
                        },
                        {
                            "action":  "edit",
                            "resource":  "docs/STATUS.md",
                            "effect":  "deny"
                        },
                        {
                            "action":  "edit",
                            "resource":  "docs/PROJECT-PLAN.md",
                            "effect":  "deny"
                        },
                        {
                            "action":  "shell",
                            "resource":  "git push *",
                            "effect":  "deny"
                        },
                        {
                            "action":  "external_directory",
                            "resource":  "*",
                            "effect":  "ask"
                        }
                    ]
}